    )

    headers = {
        "Authorization": basic_auth(
            ctx.apigee_user,
            ctx.apigee_password,
        ),
        "Accept": "application/json",
    }

    body = {
        "consumerKey": sos_client_id,
        "consumerSecret": "",
    }

    logger.info(
        "Creando key de Apigee con clientId SOS %s",
        sos_client_id,
    )

    logger.info(
        "Payload Apigee key: %s",
        json.dumps(body, ensure_ascii=False),
    )

    _, response_data = http_json(
        "POST",
        url,
        headers,
        body,
    )

    logger.info(
        "Respuesta Apigee key: %s",
        json.dumps(
            response_data,
            ensure_ascii=False,
        )
        if isinstance(response_data, dict)
        else str(response_data),
    )

    return (
        response_data
        if isinstance(response_data, dict)
        else {}
    )


def delete_default_key(
    ctx: Context,
    default_key: str,
    logger: logging.Logger,
) -> None:
    """Elimina la key generada automáticamente por Apigee."""
    url = (
        f"https://{ctx.apigee_url_base}"
        "/developers/"
        f"{enc(ctx.developer_email)}"
        "/apps/"
        f"{enc(ctx.app_name)}"
        "/keys/"
        f"{enc(default_key)}"
    )

    headers = {
        "Authorization": basic_auth(
            ctx.apigee_user,
            ctx.apigee_password,
        ),
        "Accept": "application/json",
    }

    logger.info(
        "Eliminando key por defecto: %s",
        default_key,
    )

    http_json(
        "DELETE",
        url,
        headers,
    )

    logger.info(
        "Key por defecto eliminada correctamente.",
    )


def fetch_apigee_products(
    apigee_url_base: str,
    apigee_user: str,
    apigee_password: str,
    logger: logging.Logger,
) -> list[str]:
    """Consulta el catálogo de productos disponibles en Apigee."""
    url = (
        f"https://{apigee_url_base}"
        "/apiproducts"
    )

    headers = {
        "Authorization": basic_auth(
            apigee_user,
            apigee_password,
        ),
        "Accept": "application/json",
    }

    logger.info(
        "Consultando productos disponibles en Apigee.",
    )

    _, response_data = http_json(
        "GET",
        url,
        headers,
    )

    products = []

    if isinstance(response_data, list):
        for item in response_data:
            if isinstance(item, dict) and item.get("name"):
                products.append(item["name"])

    logger.info(
        "Productos disponibles detectados: %s",
        ", ".join(products) if products else "(ninguno)",
    )

    return products


def list_apigee_products(
    ctx: Context,
    logger: logging.Logger,
) -> list[str]:
    """Lista los productos disponibles en Apigee."""
    return fetch_apigee_products(
        ctx.apigee_url_base,
        ctx.apigee_user,
        ctx.apigee_password,
        logger,
    )


_PRODUCT_SEPARATORS = re.compile(r"[,;\s]+")
_LEADING_BULLET = re.compile(r"^[\-\*\u2022]+\s*")


def _extract_products_from_line(line: str) -> list[str]:
    """
    Extrae nombres de producto de una línea de texto.

    Admite viñetas al principio de línea ("- producto", "* producto") y
    separadores mezclados: comas, punto y coma o espacios. Cada nombre
    se limpia de puntos y espacios sobrantes al final (habitual al pegar
    listas copiadas de un ticket).
    """
    line = _LEADING_BULLET.sub("", line.strip())

    return [
        item.strip(" .")
        for item in _PRODUCT_SEPARATORS.split(line)
        if item.strip(" .")
    ]


def ask_products(
    available_products: list[str],
    intro: str,
) -> list[str]:
    """
    Solicita productos al usuario, pensado para pegar directamente
    desde un ticket.

    - Se puede pegar todo de una vez, en varias líneas: cada línea se
      procesa automáticamente y se sigue pidiendo hasta una línea vacía.
    - Dentro de cada línea, los productos pueden ir separados por comas,
      punto y coma o espacios, en cualquier combinación.
    - Se eliminan duplicados (comparando sin distinguir mayúsculas).
    - Si se conoce el catálogo real de Apigee, se muestra antes de pedir
      la entrada y, al terminar, se avisa (sin bloquear) de los productos
      introducidos que no aparezcan en ese catálogo.
    """
    if available_products:
        print("\nProductos disponibles en Apigee:")
        for product in available_products:
            print(f" - {product}")
    else:
        print(
            "\nNo se ha podido consultar el catálogo de productos "
            "de Apigee."
        )

    print(f"\n{intro}")

    products: list[str] = []
    seen: set[str] = set()

    while True:
        raw_line = input("Producto(s): ").strip()

        if not raw_line:
            break

        for item in _extract_products_from_line(raw_line):
            key = item.lower()

            if key not in seen:
                seen.add(key)
                products.append(item)

    if available_products and products:
        available_lower = {p.lower() for p in available_products}
        unknown = [
            product
            for product in products
            if product.lower() not in available_lower
        ]

        if unknown:
            print(
                "\nAviso: los siguientes productos no aparecen en el "
                "catálogo de Apigee y podrían no existir: "
                + ", ".join(unknown)
            )

    return products


def add_product_to_client_id(
    ctx: Context,
    sos_client_id: str,
    logger: logging.Logger,
) -> bool:
    """Añade los productos al client ID creado en Apigee."""
    url = (
        f"https://{ctx.apigee_url_base}"
        "/developers/"
        f"{enc(ctx.developer_email)}"
        "/apps/"
        f"{enc(ctx.app_name)}"
        "/keys/"
        f"{enc(sos_client_id)}"
    )

    headers = {
        "Authorization": basic_auth(
            ctx.apigee_user,
            ctx.apigee_password,
        ),
        "Accept": "application/json",
    }

    body = {
        "apiProducts": ctx.products,
    }

    logger.info(
        "Añadiendo productos al clientId SOS %s",
        sos_client_id,
    )

    logger.info(
        "Payload add products: %s",
        json.dumps(body, ensure_ascii=False),
    )

    try:
        http_json(
            "POST",
            url,
            headers,
            body,
        )

        logger.info(
            "Productos añadidos correctamente.",
        )

        return True

    except Exception as exc:
        logger.error(
            "No se han podido añadir los productos: %s",
            exc,
        )

        return False


def check_sos_client_id(
    ctx: Context,
    sos_client_id: str,
    logger: logging.Logger,
) -> None:
    """Comprueba que el client ID existe en SOS."""
    url = (
        f"https://{ctx.sos_url_base}"
        "/sos/manager/oauth/clients/"
        f"{enc(sos_client_id)}"
    )

    headers = {
        "Authorization": basic_auth(
            ctx.sos_user,
            ctx.sos_password,
        ),
        "Accept": "application/json",
    }

    logger.info(
        "Comprobando clientId en SOS %s",
        sos_client_id,
    )

    _, response_data = http_json(
        "GET",
        url,
        headers,
    )

    logger.info(
        "Respuesta SOS clientID: %s",
        json.dumps(
            response_data,
            ensure_ascii=False,
        )
        if isinstance(response_data, dict)
        else str(response_data),
    )


def extract_default_key(response_data: dict) -> str | None:
    """Extrae la key automática generada al crear la app."""
    credentials = response_data.get("credentials") or []

    if not credentials:
        return None

    first_credential = credentials[0]

    if not isinstance(first_credential, dict):
        return None

    return first_credential.get("consumerKey")


def save_final_credentials(
    ctx: Context,
    sos_client_id: str,
    sos_client_secret: str,
) -> None:
    """Guarda el resultado final del proceso."""
    output_path = os.path.join(
        LOG_DIR,
        "final_credentials.json",
    )

    output_data = {
        "org": ctx.org,
        "env": ctx.env,
        "sos": {
            "clientId": sos_client_id,
            "clientSecret": sos_client_secret,
        },
        "apigee": {
            "developerEmail": ctx.developer_email,
            "appName": ctx.app_name,
            "products": ctx.products,
        },
    }

    with open(
        output_path,
        "w",
        encoding="utf-8",
    ) as output_file:
        json.dump(
            output_data,
            output_file,
            ensure_ascii=False,
            indent=2,
        )


def main() -> None:
    """Ejecuta el flujo completo de sincronización."""
    logger = setup_logger()

    config = load_config(CONFIG_FILE)
    context = get_context(config, logger)

    logger.info(
        "Inicio flujo org=%s env=%s developer=%s",
        context.org,
        context.env,
        context.developer_email,
    )

    sos_response = create_sos_credentials(
        context,
        logger,
    )

    sos_client_id = sos_response.get(
        "clientId",
        context.client_id,
    )

    sos_client_secret = sos_response.get(
        "clientSecret",
        context.client_secret,
    )

    add_sos_scopes(
        context,
        sos_client_id,
        logger,
    )

    app_exists = apigee_app_exists(
        context,
        context.app_name,
        logger,
    )

    default_key = None

    if app_exists:
        logger.info(
            "La developer app '%s' ya existe en Apigee. Se omite su "
            "creación y el borrado de la key por defecto; solo se "
            "añadirán las credenciales del SOS.",
            context.app_name,
        )
    else:
        app_response = create_apigee_app(
            context,
            logger,
        )

        default_key = extract_default_key(
            app_response,
        )

        if not default_key:
            app_by_name = get_apigee_app_by_name(
                context,
                context.app_name,
                logger,
            )

            default_key = extract_default_key(
                app_by_name,
            )

    create_apigee_key(
        context,
        sos_client_id,
        logger,
    )

    products_added = add_product_to_client_id(
        context,
        sos_client_id,
        logger,
    )

    if not products_added:
        available_products = list_apigee_products(
            context,
            logger,
        )

        context.products = ask_products(
            available_products,
            "No se pudieron añadir los productos. Introduce de nuevo "
            "los apiProducts (puedes pegar varias líneas; separa por "
            "comas, espacios o punto y coma), o pulsa Enter para "
            "omitirlos.",
        )

        if context.products:
            products_added = add_product_to_client_id(
                context,
                sos_client_id,
                logger,
            )

            if not products_added:
                logger.error(
                    "No se han podido añadir los productos "
                    "tras el segundo intento."
                )
        else:
            logger.info(
                "Se omite el alta de productos "
                "por decisión del usuario."
            )

    if app_exists:
        logger.info(
            "La developer app ya existía: no se borra ninguna key "
            "por defecto."
        )
    elif default_key:
        delete_default_key(
            context,
            default_key,
            logger,
        )
    else:
        logger.info(
            "No se encontró default_key en la respuesta "
            "de la app; se omite el borrado."
        )

    check_sos_client_id(
        context,
        sos_client_id,
        logger,
    )

    save_final_credentials(
        context,
        sos_client_id,
        sos_client_secret,
    )

    logger.info(
        "Proceso completado correctamente.",
    )

    print("\nOK")
    print(
        f"Credenciales guardadas en "
        f"{LOG_DIR}/final_credentials.json"
    )
    print(
        f"Logs en {LOG_DIR}/western_sync.log"
    )
    print(
        f"Developer App {context.app_name} creada con clientId "
        f"{sos_client_id} generado en el SOS. "
        "Contacte via Teams para obtener el secret. Gracias."
    )


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nProceso cancelado por el usuario.")
        sys.exit(130)
    except Exception as exc:
        print(f"Error: {exc}")
        sys.exit(1)
