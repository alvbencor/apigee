def create_apigee_key(
    ctx: Context,
    sos_client_id: str,
    logger: logging.Logger,
) -> dict:
    """Crea en Apigee una key con el client ID de SOS."""
    url = (
        f"https://{ctx.apigee_url_base}"
        "/developers/"
        f"{enc(ctx.developer_email)}"
        "/apps/"
        f"{enc(ctx.app_name)}"
